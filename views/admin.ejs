<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>어드민 로그인</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { padding: 2rem; background-color: #ffffff; }
    .card { max-width: 400px; margin: auto; border-radius: 1rem; }
  </style>
</head>
<body>
  <div class="container">
    <h3 class="text-center mb-4">🛡️ 관리자 로그인</h3>
    <div class="card shadow p-4">
      <form method="POST" action="/admin-login">
        <input type="password" class="form-control mb-3" name="password" placeholder="비밀번호 입력" required />
        <button class="btn btn-dark w-100">로그인</button>
      </form>
      <% if (error) { %>
        <p class="text-danger mt-3 text-center"><%= error %></p>
      <% } %>
    </div>
  </div>
</body>
</html>
